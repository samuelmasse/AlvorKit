<configuration>
    <packageSources>
        <clear />
        <add key="candidate" value="../out/miniaudio-packages" />
        <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    </packageSources>
    <packageSourceMapping>
        <packageSource key="candidate">
            <package pattern="AlvorKit.MiniAudio*" />
        </packageSource>
        <packageSource key="nuget.org">
            <package pattern="*" />
        </packageSource>
    </packageSourceMapping>
</configuration>

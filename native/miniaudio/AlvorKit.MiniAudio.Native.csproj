<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <PackageLicenseExpression>MIT-0 AND BSD-3-Clause</PackageLicenseExpression>
        <Description>miniaudio $(Version) binaries for win (x64, x86, arm64), linux (x64, arm,
            arm64) and osx (x64, arm64)</Description>
        <RepositoryUrl>https://github.com/mackron/miniaudio</RepositoryUrl>
    </PropertyGroup>

    <ItemGroup>
        <None Include="THIRD-PARTY-NOTICES.txt" Pack="true" PackagePath="" />
    </ItemGroup>

    <ItemGroup>
        <RequiredMiniAudioRuntime Include="win-x64/native/miniaudio.dll;win-x86/native/miniaudio.dll;win-arm64/native/miniaudio.dll" />
        <RequiredMiniAudioRuntime Include="linux-x64/native/libminiaudio.so;linux-arm64/native/libminiaudio.so;linux-arm/native/libminiaudio.so" />
        <RequiredMiniAudioRuntime Include="osx-x64/native/libminiaudio.dylib;osx-arm64/native/libminiaudio.dylib" />
    </ItemGroup>
    <Target Name="EnsureCompleteMiniAudioPackage" BeforeTargets="GenerateNuspec">
        <Error Condition="!Exists('$(MSBuildProjectDirectory)/runtimes/%(RequiredMiniAudioRuntime.Identity)')"
               Text="Missing MiniAudio runtime %(RequiredMiniAudioRuntime.Identity). Use the full MiniAudio release workflow." />
    </Target>

</Project>

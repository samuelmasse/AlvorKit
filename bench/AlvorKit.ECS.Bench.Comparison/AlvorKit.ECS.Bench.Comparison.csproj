<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    </PropertyGroup>
    <ItemGroup>
        <ProjectReference Include="../../src/AlvorKit.Bench/AlvorKit.Bench.csproj" />
        <ProjectReference Include="../../scripts/AlvorKit.Script.Workspace/AlvorKit.Script.Workspace.csproj" />
        <ProjectReference Include="../../src/AlvorKit.ECS.Indexed/AlvorKit.ECS.Indexed.csproj" />
        <ProjectReference Include="../../src/AlvorKit.ECS.Generator/AlvorKit.ECS.Generator.csproj"
            OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
        <PackageReference Include="Arch" Version="2.1.0" EcsFramework="Arch" />
        <PackageReference Include="Arch.System" Version="1.1.0" />
        <PackageReference Include="Arch.System.SourceGenerator" Version="2.1.0" PrivateAssets="all" />
        <PackageReference Include="DefaultEcs" Version="0.18.0-beta01" EcsFramework="DefaultEcs" />
        <PackageReference Include="DefaultEcs.Analyzer" Version="0.17.0" PrivateAssets="all" />
        <PackageReference Include="Entitas" Version="1.14.2" EcsFramework="Entitas" />
        <PackageReference Include="fennecs" Version="0.7.3" EcsFramework="Fennecs" />
        <PackageReference Include="Flecs.NET.Release" Version="4.0.4-build.548" EcsFramework="FlecsNet" />
        <PackageReference Include="Frent" Version="8.0.0-beta" EcsFramework="Frent" />
        <PackageReference Include="Friflo.Engine.ECS" Version="4.0.0-preview.2" EcsFramework="FrifloEngineEcs" />
        <PackageReference Include="Scellecs.Morpeh" Version="2024.1.1" EcsFramework="Morpeh" />
        <PackageReference Include="Svelto.ECS" Version="3.5.2" EcsFramework="SveltoECS" />
        <!-- 3.7.x resets AssemblyVersion to 0.0.0.0 and cannot satisfy Svelto.ECS 3.5.2's 3.4.0.0 reference. -->
        <PackageReference Include="Svelto.Common" Version="3.6.0" />
        <AssemblyMetadata Include="@(PackageReference->'EcsPackage:%(Identity)')"
            Value="%(Version)|%(EcsFramework)" />
        <InternalsVisibleTo Include="AlvorKit.ECS.Bench.Comparison.Test" />
        <Using Include="System.Diagnostics" />
        <Using Include="System.Reflection" />
        <Using Include="System.Runtime.Intrinsics" />
        <Using Include="System.Text.Json" />
        <Using Include="System.Text.Json.Nodes" />
        <Using Include="System.CommandLine" />
    </ItemGroup>
</Project>

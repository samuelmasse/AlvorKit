{
  "schemaVersion": 2,
  "fastNoiseVersion": "1.1.1",
  "bindingVersion": "1.1.1.3",
  "purpose": "Curated agent knowledge over the complete FastNoise2 runtime metadata exposed by AlvorKit.",
  "integerVariableNames": ["Seed Offset", "Value Index", "Distance Index 0", "Distance Index 1", "Octaves", "Pow"],
  "samplingCapabilities": [
    { "name": "GenUniformGrid2D", "dimensions": 2, "layout": "X then Y", "use": "Regular 2D textures and height fields." },
    { "name": "GenUniformGrid3D", "dimensions": 3, "layout": "X then Y then Z", "use": "Volumes, voxels, and 3D slices." },
    { "name": "GenUniformGrid4D", "dimensions": 4, "layout": "X then Y then Z then W", "use": "4D fields and animated 3D slices." },
    { "name": "GenPositionArray2D", "dimensions": 2, "layout": "Caller position order", "use": "Arbitrary or reusable 2D sample positions." },
    { "name": "GenPositionArray3D", "dimensions": 3, "layout": "Caller position order", "use": "Arbitrary or reusable 3D sample positions." },
    { "name": "GenPositionArray4D", "dimensions": 4, "layout": "Caller position order", "use": "Arbitrary or reusable 4D sample positions." },
    { "name": "GenTileable2D", "dimensions": 2, "layout": "X then Y", "use": "Seamless 2D output evaluated through a 4D hypertorus." },
    { "name": "GenSingle2D", "dimensions": 2, "layout": "Single value", "use": "One isolated 2D sample; not bulk generation." },
    { "name": "GenSingle3D", "dimensions": 3, "layout": "Single value", "use": "One isolated 3D sample; not bulk generation." },
    { "name": "GenSingle4D", "dimensions": 4, "layout": "Single value", "use": "One isolated 4D sample; not bulk generation." },
    { "name": "BatchMinMax", "dimensions": 0, "layout": "Two-float output span", "use": "Optional minimum and maximum for numeric batch output." }
  ],
  "bindingCapabilities": [
    { "name": "Encoded tree loading", "available": true, "api": "NewFromEncodedNodeTree" },
    { "name": "Runtime node metadata", "available": true, "api": "GetMetadata*" },
    { "name": "Dynamic node construction", "available": true, "api": "NewFromMetadata" },
    { "name": "Variable configuration", "available": true, "api": "SetVariableFloat and SetVariableIntEnum" },
    { "name": "Required source connections", "available": true, "api": "SetNodeLookup" },
    { "name": "Hybrid constant and node inputs", "available": true, "api": "SetHybridFloat and SetHybridNodeLookup" },
    { "name": "SIMD selection and reporting", "available": true, "api": "maxFeatureSet and GetActiveFeatureSet" },
    { "name": "Programmatic graph encoding", "available": false, "api": "Not present in FastNoise_C.h" },
    { "name": "Custom FastSIMD nodes", "available": false, "api": "C++ extension surface only" },
    { "name": "Node Editor IPC", "available": false, "api": "Separate upstream library, not packaged by AlvorKit" }
  ],
  "wrapperContract": {
    "package": "AlvorKit.FastNoise2.Graph",
    "namespace": "AlvorKit",
    "ownership": "FnGraph retains one finalizable SafeHandle per created native root. FnGraphNode copies keep the graph alive without cloning nodes or duplicating native references.",
    "configuration": "Create and connect the complete acyclic graph before sampling. Exact metadata, ownership, and cycle checks occur only during cold graph mutation.",
    "hybridReplacement": "A node-backed hybrid may replace another node. FastNoise2 1.1.1 cannot detach it, so the wrapper rejects a later constant assignment.",
    "sampling": "Batch sampling is managed-allocation-free and does not validate graph state. It retains only constant-time span bounds and overlap checks that protect native memory.",
    "nodeLifetime": "SafeHandle finalizers call DeleteNodeRef after FnGraph and all of its FnGraphNode values become unreachable. FnGraph has no Clear or Dispose API.",
    "encodedTrees": "CreateEncoded loads a complete version-coupled Base64 tree and exposes only its root. The binding cannot export trees.",
    "numericBounds": "FastNoise metadata minimums and maximums are editor guidance and native setters do not generally enforce them.",
    "enumOrdinals": "Except FnFeatureSet, managed enum integers are wrapper details, not native metadata IDs, native option indexes, or stable serialization values."
  },
  "managedMethods": [
    { "owner": "FnGraph", "signature": "FnGraph(Fn fn)", "purpose": "Create a configuration context and request the fastest supported compiled SIMD implementation." },
    { "owner": "FnGraph", "signature": "FnGraph(Fn fn, FnFeatureSet maximumFeatureSet)", "purpose": "Create a configuration context while limiting native SIMD dispatch." },
    { "owner": "FnGraph", "signature": "FnGraphNode Create(FnNodeType type)", "purpose": "Create a graph-managed node from exact runtime metadata and retain its finalizable native reference." },
    { "owner": "FnGraph", "signature": "FnGraphNode CreateEncoded(string encodedTree)", "purpose": "Load a complete encoded node tree and retain its root in a finalizable native handle." },
    { "owner": "FnGraphNode", "signature": "FnGraphNode Float(FnFloatVariable variable, float value)", "purpose": "Set a float metadata variable." },
    { "owner": "FnGraphNode", "signature": "FnGraphNode Integer(FnIntegerVariable variable, int value)", "purpose": "Set an integer metadata variable." },
    { "owner": "FnGraphNode", "signature": "FnGraphNode DistanceFunction(FnDistanceFunction value)", "purpose": "Set Distance Function on point-distance or cellular nodes." },
    { "owner": "FnGraphNode", "signature": "FnGraphNode CellularReturnType(FnCellularReturnType value)", "purpose": "Set CellularDistance Return Type." },
    { "owner": "FnGraphNode", "signature": "FnGraphNode Interpolation(FnInterpolation value)", "purpose": "Set Fade interpolation." },
    { "owner": "FnGraphNode", "signature": "FnGraphNode ClampOutput(bool value)", "purpose": "Set Remap output clamping." },
    { "owner": "FnGraphNode", "signature": "FnGraphNode RemovedDimension(FnRemovedDimension value)", "purpose": "Set RemoveDimension's omitted axis." },
    { "owner": "FnGraphNode", "signature": "FnGraphNode RotationType(FnRotationType value)", "purpose": "Set DomainRotatePlane's 3D plane preset." },
    { "owner": "FnGraphNode", "signature": "FnGraphNode VectorizationScheme(FnVectorizationScheme value)", "purpose": "Set simplex domain-warp displacement-vector construction." },
    { "owner": "FnGraphNode", "signature": "FnGraphNode Hybrid(FnHybrid hybrid, float value)", "purpose": "Set a hybrid constant when no node is connected." },
    { "owner": "FnGraphNode", "signature": "FnGraphNode Hybrid(FnHybrid hybrid, FnGraphNode source)", "purpose": "Connect the active spatially varying value of a hybrid input." },
    { "owner": "FnGraphNode", "signature": "FnGraphNode Source(FnSource source, FnGraphNode value)", "purpose": "Connect a required same-graph source while preserving acyclicity." },
    { "owner": "FnGraphNode", "signature": "FnFeatureSet GetActiveFeatureSet()", "purpose": "Report the cumulative FastSIMD mask selected for the node." },
    { "owner": "FnGraphNodeSampling", "signature": "GenUniformGrid2D/3D/4D(...)", "purpose": "Generate a regular row-major batch, with optional two-float min/max output." },
    { "owner": "FnGraphNodeSampling", "signature": "GenPositionArray2D/3D/4D(...)", "purpose": "Generate one sample per structure-of-arrays position, with optional min/max output." },
    { "owner": "FnGraphNodeSampling", "signature": "GenTileable2D(...)", "purpose": "Generate a seamless 2D tile through a 4D hypertorus, with optional min/max output." },
    { "owner": "FnGraphNodeSampling", "signature": "GenSingle2D/3D/4D(...)", "purpose": "Generate one isolated sample; slow per sample because SIMD lanes are underused." }
  ],

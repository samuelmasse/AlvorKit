<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>AlvorKit · ECS comparison</title>
<style>
:root{color-scheme:dark;--bg:#14161a;--panel:#1c1f24;--text:#e7eaee;--muted:#acb3be;--line:#363c45;--accent:#a9c3e5}
*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--text);font:14px/1.5 system-ui,sans-serif}
main{max-width:1440px;margin:auto;padding:38px 32px 64px}
h1{font-size:34px;letter-spacing:-1px;margin:5px 0 8px}h2{font-size:22px;margin:0 0 6px}h3{font-size:16px;margin:24px 0 8px}
p{margin:6px 0 14px}
.muted,small{color:var(--muted)}.panel{background:var(--panel);border:1px solid var(--line);border-radius:14px;padding:22px;margin-top:22px}
.controls{display:flex;flex-wrap:wrap;align-items:end;gap:20px}.controls label{display:grid;gap:5px;font-size:12px;font-weight:650}
select{font:inherit;color:inherit;background:var(--panel);border:1px solid var(--line);border-radius:7px;padding:8px 12px}
select:focus-visible,a:focus-visible{outline:2px solid var(--accent);outline-offset:2px}.right{margin-left:auto}
.legend{display:flex;gap:16px;align-items:center;flex-wrap:wrap;font-size:12px;margin:15px 0}.swatch{display:inline-block;width:12px;height:12px;border-radius:3px;margin-right:5px}
.scroll{overflow:auto}table{border-collapse:separate;border-spacing:0;width:100%;font-variant-numeric:tabular-nums}
th,td{padding:9px 11px;border-bottom:1px solid var(--line);text-align:right}th{font-size:12px;color:var(--muted);font-weight:600}
th:first-child,td:first-child{text-align:left}thead th{white-space:nowrap}tbody tr:last-child td,tbody tr:last-child th{border-bottom:0}
.heatmap{min-width:720px}.heatmap th:first-child{width:160px}.heatmap tbody th{color:var(--text);font-size:13px;font-weight:650}
.heatmap th,.heatmap td{padding:8px 6px}.heatmap thead .column-title{display:block;padding:8px 7px;font-size:12px}
.heatmap small{display:block;font-size:10px;font-weight:400;max-width:185px;overflow:hidden;text-overflow:ellipsis}
.cell{display:block;width:100%;border:0;padding:7px 3px;border-radius:5px;font-weight:700;white-space:nowrap;text-align:center;background:var(--cell);color:#f0f2f5}
.cell small{color:inherit;opacity:.72}.cell.unavailable{background:var(--bg);color:var(--muted);font-weight:400}
.cell a{color:inherit;text-underline-offset:2px}
.note{font-size:12px;color:var(--muted);max-width:1100px}
.bars{display:grid;gap:10px;margin:22px 0}.bar-row{display:grid;grid-template-columns:170px 1fr 115px;gap:15px;align-items:center}
.bar-label{font-size:12px}.bar-label small{display:block;font-size:10px}.track{height:24px;position:relative;background:var(--bg);border-radius:4px}
.bar{height:100%;background:#839fbe;border-radius:4px;min-width:2px}.range{position:absolute;top:11px;height:2px;background:var(--text);min-width:2px}
.range:before,.range:after{content:'';position:absolute;top:-3px;width:1px;height:8px;background:var(--text)}.range:after{right:0}
.bar-value{text-align:right;font-size:12px;font-variant-numeric:tabular-nums}
.details-table{font-size:12px;min-width:850px}.details-table td:nth-child(2){text-align:left}
a{color:var(--accent)}.empty{padding:24px;color:var(--muted)}
@media(max-width:700px){main{padding:24px 14px}.panel{padding:16px}h1{font-size:28px}.bar-row{grid-template-columns:120px 1fr 85px;gap:8px}.right{margin-left:0}}
</style>
</head>
<body>
<main>
<header><h1>ECS performance</h1><p class="muted" id="run-summary"></p></header>
<section class="panel" aria-labelledby="overview-title">
<div class="controls">
<h2 id="overview-title">Performance by workload</h2>
<label class="right">Mode<select id="mode"><option value="Scalar">Scalar</option><option value="Simd">SIMD</option></select></label>
<label>Nonmatching Ents<select id="padding"><option value="0">None</option><option value="10">10 per matching Ent</option></select></label>
</div>
<div class="legend"><span><i class="swatch" style="background:#264c40"></i>1.00× fastest</span><span><i class="swatch" style="background:#56502b"></i>2× the time</span><span><i class="swatch" style="background:#663c32"></i>4× or more</span><span>— Unavailable / not run</span></div>
<p class="note">a, b, c are separate integer components. Mixed updates four fixed component compositions.</p>
<div class="scroll"><table class="heatmap" id="heatmap"></table></div>
</section>
<section class="panel" id="detail" aria-labelledby="detail-title">
<div class="controls"><h2 id="detail-title"></h2><label class="right">Workload<select id="scenario"></select></label></div>
<p id="operation"></p><div class="bars" id="bars"></div>
<p class="note">Bars: median ns/Ent · Whiskers: min–max</p>
<h3>All variants</h3><p class="note">★ Used in the overview · Code links open VS Code</p>
<div class="scroll"><table class="details-table" id="variants"></table></div>
</section>
</main>
<script type="application/json" id="data">{{Data}}</script>
<script type="application/json" id="sources">{{Sources}}</script>
<script>
'use strict';
const data = JSON.parse(document.getElementById('data').textContent);
const meta = data.ecsComparison;
const sources = JSON.parse(document.getElementById('sources').textContent);
const scenarios = [
  ['Create1','Create · 1','Create Ents with one zero-initialized integer component.','1 component'],
  ['Create2','Create · 2','Create Ents with two zero-initialized integer components.','2 components'],
  ['Create3','Create · 3','Create Ents with three zero-initialized integer components.','3 components'],
  ['Update1','Update · 1','a += 1 on every matching Ent.','a += 1'],
  ['Update2','Update · 2','a += b on every matching Ent.','a += b'],
  ['Update3','Update · 3','a += b + c on every matching Ent.','a += b + c'],
  ['Mixed','Mixed','a += b across four fixed component compositions.','a += b · 4 shapes']
];
const frameworks = [...new Set(meta.approaches.map(x => x.framework))];
const rowKey = (framework,storage) => `${framework}/${storage}`;
const rowLabel = (framework,storage) => storage ? `${framework} / ${storage}` : framework;
const rows = frameworks.flatMap(framework =>
  [...new Set(meta.approaches.filter(x => x.framework === framework).map(x => x.storage))].sort().map(storage =>
    ({framework,storage,key:rowKey(framework,storage),label:rowLabel(framework,storage)})));
const $ = id => document.getElementById(id);
const escape = value => String(value).replace(/[&<>"']/g, x => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[x]));
const number = value => value.toLocaleString(undefined, {maximumSignificantDigits:4});
const allocation = value => value.toLocaleString(undefined, {maximumSignificantDigits:3});
function sourceLink(entry,kind,label){
  const source = sources.approaches[`${entry.scenario}/${entry.mode}/${entry.framework}/${entry.variant}`][kind];
  const root = sources.root.replaceAll('\\','/').replace(/\/+$/,'');
  const path = `${root}/${source.path}`;
  const encoded = path.split('/').map((part,index) => index===0 && /^[A-Za-z]:$/.test(part) ? part : encodeURIComponent(part)).join('/');
  const title = `Open ${kind==='workload'?'timed workload':'setup and timing'} in VS Code: ${source.path}:${source.line}`;
  return `<a href="vscode://file/${encoded}:${source.line}:1" title="${escape(title)}">${escape(label)}</a>`;
}
const median = values => {
  const sorted = [...values].sort((a,b) => a-b);
  const middle = Math.floor(sorted.length/2);
  return sorted.length % 2 ? sorted[middle] : (sorted[middle-1]+sorted[middle])/2;
};
const cases = data.benchmarks.map(entry => {
  const [scenario,n,p,mode,framework,variant] = entry.id.split('/');
  const approach = meta.approaches.find(x => x.scenario === scenario && x.framework === framework && x.mode === mode && x.variant === variant);
  const times = entry.samples.map(x => x.elapsedNanoseconds/x.operationCount);
  const bytes = entry.samples.map(x => x.allocations.workloadBytes === null ? null : x.allocations.workloadBytes/x.operationCount);
  return {...entry, scenario, count:Number(n.slice(1)), padding:Number(p.slice(7)), mode, framework, variant,
    storage:approach.storage, row:rowKey(framework,approach.storage), label:rowLabel(framework,approach.storage),
    representative:approach.representative === true, times, median:median(times), min:Math.min(...times), max:Math.max(...times),
    bytes:bytes.every(x => x !== null) ? median(bytes) : null};
});
let selectedScenario = (cases.find(x => x.representative) || cases[0]).scenario;
$('scenario').innerHTML = scenarios.map(([id,label,,operation]) =>
  `<option value="${id}">${label} — ${operation}</option>`).join('');
$('scenario').value = selectedScenario;
const initial = cases.find(x => x.representative) || cases[0];
const count = initial.count;
$('mode').value = initial.mode;
$('padding').value = initial.padding;
$('run-summary').textContent = `${count.toLocaleString()} Ents · Median time per Ent · Lower is better`;
function matching(scenario){
  return cases.filter(x => x.scenario === scenario && x.mode === $('mode').value && x.count === count && x.padding === Number($('padding').value));
}
function representatives(scenario){ return matching(scenario).filter(x => x.representative).sort((a,b) => a.median-b.median); }
function missing(scenario,row){
  if(Number($('padding').value) && !scenario.startsWith('Update')) return 'Padding does not apply';
  const authored = meta.approaches.some(x => x.scenario === scenario && x.framework === row.framework && x.storage === row.storage && x.mode === $('mode').value && x.representative);
  if(authored) return 'Not run';
  if(row.storage === 'Sparse' && $('mode').value === 'Simd') return 'Sparse storage has no aligned chunk SIMD API';
  return 'No representative in this mode';
}
function color(ratio){
  const t = Math.min(1,Math.log2(ratio)/2);
  const a = t < .5 ? [38,76,64] : [86,80,43];
  const b = t < .5 ? [86,80,43] : [102,60,50];
  const weight = t < .5 ? t*2 : (t-.5)*2;
  return `rgb(${a.map((v,i) => Math.round(v+(b[i]-v)*weight)).join(',')})`;
}
function render(){
  const columns = scenarios.map(([id]) => representatives(id));
  $('heatmap').innerHTML = `<thead><tr><th>Framework</th>${scenarios.map(([id,label,,operation]) => `<th scope="col"><span class="column-title">${label}<small>${operation}</small></span></th>`).join('')}</tr></thead><tbody>`+
    rows.map(row => `<tr><th scope="row">${escape(row.label)}</th>`+
      scenarios.map(([scenario],i) => {
        const entry = columns[i].find(x => x.row === row.key);
        if(!entry) return `<td><span class="cell unavailable" title="${escape(missing(scenario,row))}">—<small>${missing(scenario,row)==='Not run'?'Not run':'Unavailable'}</small></span></td>`;
        const ratio = entry.median/columns[i][0].median;
        return `<td><span class="cell" style="--cell:${color(ratio)}" title="${escape(entry.variant)}: ${number(entry.median)} ns/Ent; ${entry.samples.length} samples">${ratio.toFixed(2)}×<small>${number(entry.median)} ns · ${sourceLink(entry,'workload','code')}</small></span></td>`;
      }).join('')+'</tr>').join('')+'</tbody>';
  renderDetails();
}
function renderDetails(){
  const scenario = scenarios.find(x => x[0] === selectedScenario);
  $('detail-title').textContent = `${scenario[1]} / ${$('mode').selectedOptions[0].text}`;
  $('operation').textContent = scenario[2]+(selectedScenario.startsWith('Create') ? '' : ' 64 passes per sample.');
  const entries = representatives(selectedScenario);
  const max = entries.length ? Math.max(...entries.map(x => x.max)) : 1;
  const position = value => value/max*100;
  $('bars').innerHTML = entries.length ? entries.map(entry => `<div class="bar-row">
    <div class="bar-label">${escape(entry.label)}<small>${sourceLink(entry,'workload',entry.variant)}</small></div>
    <div class="track" title="${number(entry.min)}–${number(entry.max)} ns/Ent"><div class="bar" style="width:${position(entry.median)}%"></div><div class="range" style="left:${position(entry.min)}%;width:${position(entry.max)-position(entry.min)}%"></div></div>
    <div class="bar-value">${number(entry.median)} ns<br><small>${(entry.median/entries[0].median).toFixed(2)}×</small></div></div>`).join('') : '<p class="empty">No representative measurements for this selection.</p>';
  const variants = matching(selectedScenario).sort((a,b) => a.median-b.median);
  $('variants').innerHTML = '<thead><tr><th>Framework</th><th>Variant</th><th>Median ns/Ent</th><th>Min–max</th><th title="Managed bytes allocated in the timed workload on the measurement thread">Managed B/Ent</th><th>Setup / timing</th></tr></thead><tbody>'+
    variants.map(entry => `<tr><td>${escape(entry.label)}</td><td>${entry.representative?'★ ':''}${sourceLink(entry,'workload',entry.variant)}</td><td>${number(entry.median)}</td><td>${number(entry.min)}–${number(entry.max)}</td><td>${entry.bytes===null?'Not measured':allocation(entry.bytes)}</td><td>${sourceLink(entry,'measurement','Open')}</td></tr>`).join('')+'</tbody>';
}
for(const id of ['mode','padding']) $(id).addEventListener('change',render);
$('scenario').addEventListener('change', () => {
  selectedScenario = $('scenario').value;
  renderDetails();
});
render();
</script>
</body>
</html>
